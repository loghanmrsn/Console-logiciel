 from zipfile import ZIP_DEFLATED, ZipFile
+import os
 
-project = Path(__file__).resolve().parents[1]
-output = project / 'builds' / 'console-ciel-source.zip'
-folders = ('scenes', 'scripts', 'assets', 'themes', 'data', 'tests', 'docs', 'tools')
