extends "res://tests/morning_services_tests.gd"
const CtfCatalog = preload("res://scripts/game/ctf_catalog.gd")
var ctf

func _run() -> void:
	await process_frame
	saves = root.get_node("SaveService")
	profiles = root.get_node("ProfileService")
	shop = root.get_node("ShopService")
	rewards = root.get_node("RewardService")
	investigation = root.get_node("InvestigationService")
	state = root.get_node("AppState")
	hotel = root.get_node("HotelService")
	ctf = root.get_node("CtfService")
	test_root = "user://tests/ctf_services_%s_%s" % [OS.get_process_id(), Time.get_ticks_usec()]
	saves.root_path = test_root
	state.clear_profile()
	_check(not ctf.submit("phishing", "sudo-hack-support.example").ok and not hotel.return_bus().ok, "Le CTF et le retour exigent un joueur actif")
	_ok(shop.load_catalog(), "Catalogue")
	_ok(rewards.load_rules(), "Règles")
	var made: Dictionary = profiles.create_profile("CTF isolé")
	if not _ok(made, "Profil créé"):
		_finish()
		return
	profile_id = str(made.data.id)
	_ok(profiles.start_game(), "Nouvelle enquête")
	_setup_stay(50)
	morning_wallet = int(state.profile.wallet.points)
	morning_run_points = int(state.profile.progress.run_reward_points)
	morning_sleep_snapshot = state.profile.duplicate(true)
	_test_morning_path(50)
	var arrival: Dictionary = state.profile.duplicate(true)
	_check(not arrival.progress.has("ctf") and not saves.read_profile(profile_id).migration_required, "Une sauvegarde 0.17 au CTF se reprend sans migration ni crédit")
	_check(ctf.state() == CtfCatalog.empty_state(), "Les anciens joueurs commencent avec cinq épreuves à résoudre")
	_assert_failed(Callable(ctf, "submit").bind("flag", "SUDO{CIEL_2026}"), "Le coffre final ne se saute pas")
	_assert_failed(Callable(ctf, "submit").bind("inconnu", "x"), "Poste inconnu refusé")
	var copy: Dictionary = ctf.state()
	copy.completed.append("flag")
	_check(ctf.state().completed.is_empty(), "La lecture renvoie une copie sans pouvoir modifier la progression")
	_ok(hotel.travel("ctf_bus_stop"), "Sortie vers l'arrêt")
	_assert_failed(Callable(hotel, "return_bus"), "Le retour reste bloqué avant les cinq réussites")
	_assert_failed(Callable(ctf, "submit").bind("phishing", "sudo-hack-support.example"), "Une réponse hors du bâtiment est refusée")
	_ok(hotel.travel("ctf_lobby"), "Retour aux postes")
	for index in range(5):
		var id: String = CtfCatalog.IDS[index]
		var answer: String = CtfCatalog.CHALLENGES[id].answer
		_check(ctf.mission_state(id) == "available", "Poste suivant disponible : " + id)
		_assert_failed(Callable(ctf, "submit").bind(id, "mauvaise réponse"), "Mauvais essai sans écriture ni gain : " + id)
		_assert_failed(Callable(ctf, "submit").bind(id, answer), "Échec disque sans réussite partielle : " + id, true)
		var result: Dictionary = ctf.submit(id, answer)
		_check(result.ok and result.reward == 50, "Réussite atomique et 50 points : " + id)
		_check(ctf.state().completed == CtfCatalog.IDS.slice(0, index + 1), "Ordre de progression durable : " + id)
		_check(saves.read_profile(profile_id).data == state.profile, "Mémoire et disque identiques : " + id)
		_check(ctf.submit(id, answer).reward == 0 and state.profile.wallet.points == 800 + 50 * index, "Une répétition ne crédite jamais deux fois : " + id)
		state.clear_profile()
		_ok(profiles.select_profile(profile_id), "Reprise réelle après chaque épreuve")
	_check(ctf.completed() and state.profile.wallet.points == 1000 and state.profile.progress.run_reward_points == 650, "Cinq épreuves ajoutent 250 points sans altérer les chapitres")
	var finished: Dictionary = state.profile.duplicate(true)
	for invalid_state in [null, [], {}, {"version": 2, "completed": []}, {"version": 1, "completed": ["flag"]}, {"version": 1, "completed": ["phishing", "phishing"]}, {"version": 1, "completed": ["phishing"], "other": true}]:
		var invalid: Dictionary = finished.duplicate(true)
		invalid.progress.ctf = invalid_state
		_check(not saves.validate_profile(invalid).ok, "CTF mal formé ou ordre falsifié refusé")
	var missing: Dictionary = finished.duplicate(true)
	missing.rewarded_missions.erase("ctf_flag")
	_check(not saves.validate_profile(missing).ok, "La progression exige chaque reçu")
	_ok(hotel.travel("ctf_bus_stop"), "Rejoindre le bus de retour")
	_assert_failed(Callable(hotel, "return_bus"), "Retour échoué conserve le lieu de départ", true)
	_ok(hotel.return_bus(), "Bus vers la ville")
	_check(state.profile.progress.room_id == "courtyard" and hotel.state().morning_stage == 9 and ctf.completed(), "Retour en ville avec toutes les réussites conservées")
	_check(state.profile.wallet.points == 1000, "Le trajet ne rapporte aucun point")
	_ok(investigation.travel_zone("room_01"), "Le premier bâtiment reste visitable après le CTF")
	_ok(investigation.travel_zone("courtyard"), "Retour à la place")
	_ok(hotel.travel("building_02"), "L'hôtel reste visitable")
	_ok(hotel.travel("courtyard"), "Sortie de l'hôtel après retour")
	_ok(hotel.board_bus(), "Revisiter le CTF")
	_ok(hotel.travel("ctf_lobby"), "Postes consultables après retour")
	_check(ctf.submit("flag", "SUDO{CIEL_2026}").reward == 0 and state.profile.wallet.points == 1000, "Revisiter reste sans double récompense")
	_ok(profiles.reset_progress(), "Recommencer avec les reçus conservés")
	_check(ctf.state().completed.is_empty() and "ctf_flag" in state.profile.rewarded_missions, "Une nouvelle partie normale efface les épreuves mais garde leurs reçus")
	var replay: Dictionary = arrival.duplicate(true)
	replay.wallet.points = 1000
	replay.rewarded_missions = finished.rewarded_missions.duplicate()
	_ok(saves.write_profile(replay), "Préparation d'un parcours rejoué")
	state.clear_profile()
	_ok(profiles.select_profile(profile_id), "Reprise du parcours rejoué")
	for id in CtfCatalog.IDS:
		_check(ctf.submit(id, CtfCatalog.CHALLENGES[id].answer).reward == 0, "Rejouer ne donne pas de nouveaux points : " + id)
	_check(state.profile.wallet.points == 1000, "Solde de fin inchangé après replay")
	var debtor: Dictionary = arrival.duplicate(true)
	debtor.wallet.points = 0
	debtor["penalties"] = {"version": 1, "count": 1, "debt": 200, "paid": 0, "last_event": "a".repeat(32)}
	_ok(saves.write_profile(debtor), "Joueur endetté validé")
	state.clear_profile()
	_ok(profiles.select_profile(profile_id), "Reprise du joueur endetté")
	for id in CtfCatalog.IDS:
		_ok(ctf.submit(id, CtfCatalog.CHALLENGES[id].answer), "Récompense CTF avec dette")
	_check(state.profile.wallet.points == 50 and root.get_node("PenaltyService").state().debt == 0, "Les 250 points remboursent 200 de dette avant de créditer 50")
	_ok(profiles.use_dev_profile(), "Création du nouveau Dev")
	_check(ctf.completed() and state.profile.wallet.points == 1000, "Un nouveau Dev possède aussi les cinq validations CTF")
	var old_dev: Dictionary = state.profile.duplicate(true)
	old_dev.progress.erase("ctf")
	old_dev.wallet.points = 750
	for id in CtfCatalog.REWARD_IDS: old_dev.rewarded_missions.erase(id)
	_ok(saves.write_profile(old_dev), "Ancien Dev 0.17 préparé")
	state.clear_profile()
	_ok(profiles.use_dev_profile(), "Reprise de l'ancien Dev sans migration")
	_check(state.profile.wallet.points == 750 and not ctf.completed(), "La sélection conserve le solde et le parcours d'un ancien Dev")
	_ok(profiles.reset_progress(), "Mise à jour explicite des validations de Dev")
	_check(ctf.completed() and state.profile.wallet.points == 750, "Réinitialiser Dev valide les nouveaux postes sans lui donner de nouveaux points")
	_finish()
