extends "res://tests/code_chapter_ui_tests.gd"
## Native controls create the dedicated Dev profile from first launch or profiles.

func _run() -> void:
	await process_frame
	saves = root.get_node("SaveService")
	profiles = root.get_node("ProfileService")
	settings = root.get_node("SettingsService")
	state = root.get_node("AppState")
	investigation = root.get_node("InvestigationService")
	router = root.get_node("SceneRouter")
	controllers = root.get_node("ControllerService")
	controllers.debug_set_devices([0])
	test_root = "user://tests/dev_ui_%s_%s" % [OS.get_process_id(), Time.get_ticks_usec()]
	saves.root_path = test_root
	settings.storage_root = test_root
	state.clear_profile()
	captures = "--screenshots" in OS.get_cmdline_user_args() and DisplayServer.get_name() != "headless"
	var values: Dictionary = settings.committed.duplicate(true)
	values.reduce_motion = true
	_check(settings.apply_settings(values).ok, "Réglages isolés du profil Dev")
	root.size = Vector2i(1280, 720)
	app = load("res://scenes/main.tscn").instantiate()
	root.add_child(app)
	await _frames(35)
	_check(app.screen == "editor" and profiles.profiles.is_empty(), "Le premier lancement conserve la création normale sans créer de compte automatiquement")
	await _activate("use_dev_profile", true)
	_check(app.screen == "home" and state.profile.display_name == "Dev" and profiles.is_super_admin(), "Le bouton dédié ouvre Dev super administrateur")
	profile_id = str(state.profile.id)
	_check(app.header_profile.text == "Dev" and "Super administrateur" in app.header_profile.tooltip_text, "L’en-tête identifie Dev et son rôle")
	_check(state.profile.wallet.points == 1000 and state.profile.progress.completed_missions.size() == 13, "Tous les défis et leurs gains sont présents à la sélection")
	await _capture("dev_accueil_challenge")
	app._show_screen("profiles")
	await _frames(8)
	_check(_find("profile_role") != null and "Super administrateur" in (_find("profile_role") as Label).text, "Le rôle est visible dans la présentation du profil")
	await _capture("dev_profils_challenge")
	await _activate("use_dev_profile")
	await _activate("continue_game", true)
	await _frames(8)
	if app.demo.overlay_kind == "conclusion": await _activate("conclusion_stay")
	_check(app.demo.world.room_id == "room_01" and app.demo.world.elevator_unlocked, "La première salle et son ascenseur sont déjà rétablis")
	await _capture("dev_premiere_salle_challenge")
	for chapter in range(2, 6):
		var result: Dictionary = investigation.enter_chapter(chapter)
		_check(result.ok, "Accès réel au chapitre " + str(chapter))
		await _frames(5)
		_check(app.demo.world.chapter_id == chapter, "Le monde présente le chapitre débloqué " + str(chapter))
	app._show_screen("profiles")
	await _frames(6)
	var before: Dictionary = state.profile.duplicate(true)
	await _activate("use_dev_profile", true)
	_check(state.profile == before and profiles.profiles.size() == 1, "Un deuxième clic ne duplique pas Dev et ne crédite aucun point")
	_check(profiles.create_profile("Élève").ok, "Un profil de joueur séparé reste disponible")
	var normal_id := str(state.profile.id)
	_check(state.profile.wallet.points == 0 and state.profile.progress.completed_missions.is_empty(), "Le joueur normal conserve une progression vide")
	app._show_screen("profiles")
	await _frames(8)
	await _activate("use_dev_profile")
	_check(state.profile.id == profile_id and saves.read_profile(normal_id).data.wallet.points == 0, "Le raccourci ne modifie pas le joueur normal")
	root.size = Vector2i(800, 480)
	var compact: Dictionary = values.duplicate(true)
	compact.large_text = true
	_check(settings.apply_settings(compact).ok, "Grand texte sur écran compact")
	app._show_screen("profiles")
	await _frames(10)
	var button := _find("use_dev_profile") as Button
	button.grab_focus()
	await _frames(8)
	_check(Rect2(Vector2.ZERO, Vector2(root.size)).encloses(button.get_global_rect()), "L’accès Dev reste visible lorsqu’il est sélectionné en 800 × 480")
	await _capture("dev_compact_challenge")
	await _activate("use_dev_profile", true)
	_check(state.profile.id == profile_id and state.profile.wallet.points == 1000, "Le profil Dev reste le même sur petit écran")
	_check(saves.read_profile(profile_id).data == state.profile, "Le dernier état correspond à une sauvegarde validée")
	await _finish()
