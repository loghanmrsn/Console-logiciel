extends "res://tests/character_ui_tests.gd"
func _run() -> void:
	await process_frame
	saves=root.get_node("SaveService");profiles=root.get_node("ProfileService");state=root.get_node("AppState");settings=root.get_node("SettingsService");router=root.get_node("SceneRouter");controllers=root.get_node("ControllerService")
	controllers.debug_set_devices([0]);test_root="user://tests/wardrobe_shop_%s"%Time.get_ticks_usec();saves.root_path=test_root;settings.storage_root=test_root
	captures="--screenshots" in OS.get_cmdline_user_args() and DisplayServer.get_name()!="headless"
	root.size=Vector2i(1280,720)
	app=load("res://scenes/main.tscn").instantiate();root.add_child(app);await _frames(30)
	_check(profiles.use_dev_profile().ok,"Profil de boutique isolé")
	app._show_screen("shop");await _frames(10)
	_check(_find("shop_filter")!=null,"Catalogue de jeux, avatars et thèmes conservé")
	await _capture("boutique_console")
	await _activate("shop_dressing",true);await _frames(8)
	var store=_find("wardrobe_shop")
	_check(store!=null and store.grid.get_child_count()==4,"Quatre hauts avec vignettes, gratuits et payants")
	await _press(KEY_E)
	_check(store.category==1,"Raccourci de catégorie suivant dans le dressing")
	await _press(KEY_Q)
	_check(store.category==0,"Raccourci de catégorie précédent dans le dressing")
	_check(store.preview.model._materials.skin is ShaderMaterial,"Matière de peau texturée réellement utilisée")
	var surfaces=preload("res://scripts/character/character_materials.gd")
	for texture in surfaces.MAPS.values():_check(texture.get_image().has_mipmaps(),"Matière filtrée pour éviter le scintillement")
	for card in store.grid.get_children():
		var pictures=card.find_children("*","TextureRect",true,false)
		_check(pictures.size()==1 and pictures[0].texture!=null,"Image 3D précalculée : "+card.item.name)
		_check(card.find_children("*","SubViewport",true,false).is_empty(),"Aucun rendu 3D permanent dans la grille")
	var original=state.profile.duplicate(true)
	await _activate("wardrobe_card_top_sweater",true)
	await _activate("wardrobe_color_cream")
	_check(store.draft.top=="sweater" and state.profile==original,"Essayer et changer de couleur ne coûte aucun point")
	_check(_find("wardrobe_price").text=="55 points" and not store.equip.visible,"Prix et article non possédé correctement présentés")
	await _capture("dressing_pull_texture")
	await _activate("wardrobe_buy")
	_check(is_instance_valid(app.modal),"Confirmation du prix avant achat")
	await _activate("modal_cancel",true)
	_check(state.profile==original,"Annuler un achat conserve le profil")
	saves.simulate_write_failure=true
	await _activate("wardrobe_buy");await _activate("modal_confirm")
	_check(state.profile==original and saves.read_profile(original.id).data==original,"Échec disque : aucun débit ou achat partiel")
	saves.simulate_write_failure=false
	await _activate("wardrobe_buy",true);await _activate("modal_confirm",true)
	_check(state.profile.wallet.points==original.wallet.points-55 and "top/sweater" in state.profile.character.owned,"Achat unique en points enregistré")
	_check(store.draft.top_color=="cream" and store.equip.visible,"Couleur d’essayage conservée après achat")
	_check(state.profile.character.appearance.top=="tee","Acheter n’équipe pas automatiquement")
	await _activate("wardrobe_equip",true)
	_check(state.profile.character.appearance.top=="sweater" and state.profile.character.appearance.top_color=="cream","Article et coloris portés après enregistrement")
	_check(store.equip.disabled and not store.buy.visible,"Aucun second débit pour l’article équipé")
	_check(saves.read_profile(original.id).data==state.profile,"Reprise persistante de l’achat et de l’apparence")
	await _option("wardrobe_filter",1)
	_check(store.grid.get_child_count()==1 and store.grid.get_child(0).item.id=="tee","Filtre des hauts gratuits")
	await _option("wardrobe_filter",2)
	_check(store.grid.get_child_count()==2,"Inventaire : gratuit et article acquis")
	await _option("wardrobe_filter",0)
	await _option("wardrobe_category",2)
	_check(store.grid.get_child_count()==4,"Casquettes et chapeaux présentés")
	await _activate("wardrobe_card_headwear_cap_denim",true)
	_check(not store.buy.visible and store.price.text=="Gratuit","Casquette denim gratuite")
	await _activate("wardrobe_card_headwear_straw")
	_check(store.buy.visible and store.price.text=="70 points","Chapeau payant avec prix exact")
	await _capture("dressing_accessoires")
	store.search.text="introuvable";store.search.text_changed.emit(store.search.text);await _frames(5)
	_check(store.grid.get_child_count()==0 and not store.preview_panel.visible,"Recherche sans résultat explicite")
	store.search.text="";store.search.text_changed.emit("");await _frames(5)
	await _option("wardrobe_category",3)
	await _activate("wardrobe_card_shoes_loafers")
	_check(store.preview.model._materials.shoes.get_shader_parameter("detail_map")==surfaces.MAPS.leather,"Cuir utilisé pour les mocassins")
	await _capture("dressing_chaussures")
	root.size=Vector2i(800,480);await _frames(12)
	var values=settings.committed.duplicate(true);values.large_text=true;values.appearance_style="nuit";settings.apply_settings(values);await _frames(10)
	await _activate("wardrobe_buy")
	_check(is_instance_valid(app.modal),"Achat accessible au clavier sur petit écran")
	await _capture("boutique_compacte_confirmation")
	await _activate("modal_cancel",true)
	store.buy.grab_focus();await _frames(8)
	_check(app.scroll.get_global_rect().grow(1).encloses(store.buy.get_global_rect()),"Achat visible au clavier en 800 × 480 avec grand texte")
	await _capture("boutique_compacte_nuit")
	values.large_text=false;values.appearance_style="profile";settings.apply_settings(values);root.size=Vector2i(1280,720);await _frames(10)
	# Free item can still be equipped when the wallet is empty.
	var doc=state.profile.duplicate(true);doc.wallet.points=0;state.commit_profile(saves.write_profile(doc).data)
	await _option("wardrobe_category",2)
	await _activate("wardrobe_card_headwear_cap_flat")
	var before=state.profile.duplicate(true)
	await _activate("wardrobe_buy")
	_check(state.profile==before and is_instance_valid(app.modal),"Solde nul : explication sans débit")
	await _activate("modal_confirm")
	await _activate("wardrobe_card_headwear_cap_denim")
	await _activate("wardrobe_equip")
	_check(state.profile.wallet.points==0 and state.profile.character.appearance.headwear=="cap_denim","Gratuit équipable sans points")
	await _activate("shop_console",true)
	_check(_find("shop_filter")!=null and app.shop_section=="console","Retour au catalogue de jeux et thèmes")
	app._show_screen("character");await _frames(10)
	var panel=_find("character_configurator")
	panel.view.focus_face(true);panel.view.refresh()
	await _capture("peau_cheveux_visage")
	await _finish()
