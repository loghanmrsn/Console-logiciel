extends "res://tests/code_chapter_ui_tests.gd"
const Mapping = preload("res://scripts/input_setup.gd")

func _run() -> void:
	await process_frame
	saves = root.get_node("SaveService")
	profiles = root.get_node("ProfileService")
	settings = root.get_node("SettingsService")
	state = root.get_node("AppState")
	investigation = root.get_node("InvestigationService")
	router = root.get_node("SceneRouter")
	controllers = root.get_node("ControllerService")
	controllers.debug_set_devices([0])
	test_root = "user://tests/comfort_%s" % Time.get_ticks_usec()
	saves.root_path = test_root
	settings.storage_root = test_root
	state.clear_profile()
	captures = "--screenshots" in OS.get_cmdline_user_args() and DisplayServer.get_name() != "headless"
	_check(profiles.use_dev_profile().ok, "Profil Dev isolé")
	profile_id = str(state.profile.id)
	# Dev starts in room 1 with all educational challenges complete.
	if investigation.current_chapter() == 0:
		var progress: Dictionary = state.profile.progress.duplicate(true)
		progress.room_id = "room_01"
		progress.checkpoint_id = "entrance"
		_check(investigation._save_progress(progress).ok, "Reprendre au bâtiment initial")
	app = load("res://scenes/main.tscn").instantiate()
	root.add_child(app)
	await _frames(25)
	app._show_screen("home")
	await _frames(5)
	await _activate("continue_game")
	var before: Dictionary = state.profile.duplicate(true)
	app.demo._show_elevator()
	await _frames(5)
	await _capture("ascenseur_direct_challenge")
	await _activate("elevator_floor_5")
	_check(investigation.current_chapter() == 5, "Trajet direct du premier au dernier chapitre")
	_check(state.profile.wallet == before.wallet and state.profile.progress.completed_missions == before.progress.completed_missions, "Trajet conserve points et réussites")
	app.demo._show_elevator()
	await _activate("elevator_floor_3")
	_check(investigation.current_chapter() == 3, "Trajet direct retour au code")
	_check("Consultez les livres" in str(_find("mission_next_step").text), "Invitation aux livres visible même après tous les défis")
	app.draft_settings = settings.current.duplicate(true)
	app._show_screen("settings")
	app.settings_category = 0
	app._show_screen("settings")
	await _frames(5)
	var selector := _find("setting_music_track") as OptionButton
	_check(selector != null and selector.item_count == 4, "Quatre musiques disponibles")
	for index in range(4):
		selector.select(index)
		selector.item_selected.emit(index)
		_check(settings.current.music_track == settings.MUSIC_TRACKS.keys()[index], "Choix musical appliqué")
		_check(settings._music_player.stream != null and settings._music_player.stream.loop_mode == AudioStreamWAV.LOOP_FORWARD, "Piste chargée en boucle")
	await _capture("musique_choix_challenge")
	app.settings_category = 3
	app._show_screen("settings")
	await _frames(5)
	await _activate("bind_game_interact_key")
	await _key(KEY_F)
	_check(settings.current.bindings.get("game_interact", {}).get("key", 0) == KEY_F, "Capture clavier réelle vers F")
	_check(InputMap.action_has_event("game_interact", Mapping._key(KEY_F)), "Entrée reconfigurée")
	await _activate("bind_game_sprint_button")
	var press := InputEventJoypadButton.new()
	press.device = 0
	press.button_index = JOY_BUTTON_RIGHT_STICK
	press.pressed = true
	Input.parse_input_event(press)
	await _frames(3)
	press = press.duplicate()
	press.pressed = false
	Input.parse_input_event(press)
	await _frames(3)
	_check(settings.current.bindings.get("game_sprint", {}).get("button", -1) == JOY_BUTTON_RIGHT_STICK, "Capture manette réelle vers R3")
	await _capture("commandes_choix_challenge")
	root.size = Vector2i(800, 480)
	await _frames(8)
	await _activate("bind_game_map_key")
	await _key(KEY_M)
	_check(settings.current.bindings.get("game_map", {}).get("key", 0) == KEY_M, "Carte personnalisée à M")
	_check(InputMap.action_has_event("game_walk_right", Mapping._key(KEY_RIGHT)), "Flèche droite libérée pour marcher après changement de la carte")
	await _activate("bind_game_interact_key")
	await _key(KEY_M)
	_check(settings.current.bindings.game_interact.key == KEY_F, "Conflit avec la carte refusé sans effacer Interagir")
	await _capture("commandes_compact_challenge")
	# Cancel capture through the panel, then restore desktop size.
	var binding_panel = _find("bind_game_interact_key").get_parent().get_parent()
	binding_panel._cancel()
	root.size = Vector2i(1280, 720)
	await _frames(5)
	var chosen: Dictionary = settings.current.duplicate(true)
	_check(settings.apply_settings(chosen).ok, "Réglages sauvegardés")
	settings.preview(settings.defaults)
	_check(settings.load_settings().ok and settings.current == chosen, "Musique et commandes rechargées")
	var persisted := FileAccess.get_file_as_string(settings._path())
	settings.force_write_failure = true
	_check(not settings.apply_settings(settings.defaults).ok, "Échec écriture signalé")
	settings.force_write_failure = false
	_check(settings.committed == chosen and FileAccess.get_file_as_string(settings._path()) == persisted, "Échec garde les réglages")
	_check(not settings.preview({"bindings": {"invalid": {"key": 1}}}).ok, "Action inconnue refusée")
	_check(not settings.preview({"music_track": "unknown"}).ok, "Piste inconnue refusée")
	settings.preview(settings.defaults)
	settings.cancel_preview()
	_check(settings.current == chosen, "Annuler restaure les choix enregistrés")
	_check(settings.apply_settings(settings.defaults).ok, "Retour aux commandes initiales")
	_check(InputMap.action_has_event("game_sprint", Mapping._key(KEY_SHIFT)), "Sprint Maj par défaut")
	_check(InputMap.action_has_event("game_sprint", Mapping._button(JOY_BUTTON_LEFT_STICK)), "Sprint L3 par défaut")
	app._show_screen("game")
	await _frames(10)
	app.demo.world.player.position = Vector2(500, 350)
	app.demo.world.player.reset_physics_interpolation()
	Input.action_press("game_right")
	await _physics_frames(12)
	var walking: float = app.demo.world.player.velocity.length()
	Input.action_press("game_sprint")
	await _physics_frames(12)
	var running: float = app.demo.world.player.velocity.length()
	Input.action_release("game_right")
	Input.action_release("game_sprint")
	await _physics_frames(3)
	_check(is_equal_approx(walking, 190.0) and is_equal_approx(running, 209.0), "Sprint exactement +10 %")
	_check(app.demo.world.player.velocity == Vector2.ZERO, "Relâcher arrête immédiatement")
	await _finish()
