; Console CIEL — Godot 4.6.3, Compatibility
config_version=5

[application]
config/name="Console CIEL"
config/icon="res://assets/console.svg"
config/version="0.21.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="console-ciel"

[autoload]
SaveService="*res://scripts/services/save_service.gd"
AppState="*res://scripts/services/app_state.gd"
ShopService="*res://scripts/services/shop_service.gd"
RewardService="*res://scripts/services/reward_service.gd"
InvestigationService="*res://scripts/services/investigation_service.gd"
HotelService="*res://scripts/services/hotel_service.gd"
CtfService="*res://scripts/services/ctf_service.gd"
PenaltyService="*res://scripts/services/penalty_service.gd"
ProfileService="*res://scripts/services/profile_service.gd"
DevConsoleService="*res://scripts/services/dev_console_service.gd"
ControllerService="*res://scripts/services/controller_service.gd"
SettingsService="*res://scripts/services/settings_service.gd"
SceneRouter="*res://scripts/services/scene_router.gd"
PlatformService="*res://scripts/services/platform_service.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=480
window/size/resizable=true
window/size/mode=0
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.953, 0.961, 0.969, 1)

[physics]

common/physics_interpolation=true

[audio]
default_bus_layout="res://default_bus_layout.tres"

[debug]
gdscript/warnings/inference_on_variant=0

